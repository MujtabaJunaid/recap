# Copy to .env for local development. .env is gitignored and must never be committed.
#
# READ THIS BEFORE ADDING A KEY.
#
# Vite inlines every variable prefixed with VITE_ into the built JavaScript at build
# time. A VITE_-prefixed secret is therefore NOT secret: it is compiled into the public
# bundle and readable by every visitor via devtools or view-source. Gitignoring .env
# keeps the value out of git; it does nothing to keep it out of the browser.
#
# So the rule for this repository is:
#
#   VITE_*  -> public configuration only. Never a credential.
#   everything else -> not exposed to client code at all, and therefore useless to a
#                      static frontend. Provider keys belong in the environment of a
#                      backend proxy, not here.
#
# `npm run check:secrets` scans the built bundle and fails if anything key-shaped made
# it in. CI runs it on every push.

# Public configuration, safe to inline.
VITE_APP_NAME=Recap

# Where a future backend proxy lives. The proxy holds provider credentials in its own
# environment and this app never sees them. See ARCHITECTURE.md, "Why the summaries are
# fixtures, and how to make them real".
# VITE_API_BASE_URL=https://api.example.com

# Do NOT put a provider key here. Not GROQ_API_KEY, not OPENAI_API_KEY, not any other.
# Even without the VITE_ prefix it cannot reach client code, so it would do nothing
# except sit on disk waiting to be committed by accident.
